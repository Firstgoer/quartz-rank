package-as: Quartz_Rank

# Development files that must not end up in the CurseForge zip.
# (.git*, .pkgmeta and dotfiles are excluded by the packager automatically.)
ignore:
  - CLAUDE.md
  - tests

# Both install as the "Quartz" folder, and their flavors don't overlap:
# quartz = original Quartz (Classic Era, TBC), quartz-midnight = Quartz Redux (Forever).
required-dependencies:
  - quartz
  - quartz-midnight

# Player-facing release notes (instead of the git commit log). Rewrite for each release.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
